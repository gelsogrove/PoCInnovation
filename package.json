{
  "name": "root-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:watch": "python3 inferences/watch.py",
    "start:backend": "cd backend && npm run dev",
    "start:frontend": "cd frontend && PORT=4000 npm start npm run start",
    "start:node-red": "cd post-processing && npm run start",
    "start:all": "npm run start:backend & npm run start:frontend & npm run start:node-red",
    "stop:all": "pkill -f 'node' && pkill -f 'nodemon'"
  },
  "dependencies": {
    "@types/axios": "^0.14.0",
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
