        "type": "function",
        "z": "e5234f1f1c23e046",
        "name": "function 1",
        "func": "let myArray = global.get('myArray') || [];\n\nmyArray.push(msg.payload);\n\nmyArray = myArray.map(item => ({\n    id: msg._msgid,\n    data: new Date(msg.timestamp).toLocaleString(),\n    hola: msg.topic,\n    age: msg.age,\n    isAdult: msg.isAdult\n}));\n\nglobal.set('myArray', myArray);\n\nmsg.payload = myArray\n\nreturn msg;\n",
